pipeline {
    agent any
    
    // Adding parameters here
    parameters {
        booleanParam(name: 'SKIP_STABILITY', defaultValue: false, description: 'Check to skip Unit Tests')
        booleanParam(name: 'SKIP_QUALITY', defaultValue: false, description: 'Check to skip Checkstyle')
        booleanParam(name: 'SKIP_COVERAGE', defaultValue: false, description: 'Check to skip Jacoco Coverage')
    }

    tools {
        maven 'maven3' 
        jdk 'jdk8'
    }

    stages {
        stage('Code Checkout') {
            steps {
                echo "Starting Code Checkout..."
                git branch: 'master', url: 'https://github.com/opstree/spring3hibernate.git'
            }
        }

        stage('Parallel Analysis') {
            parallel {
                stage('Code Stability') {
                    when { expression { return params.SKIP_STABILITY == false } }
                    steps {
                        echo "Starting Code Stability Analysis (Unit Tests)..."
                        // Added -Dfindbugs.skip=true to prevent the build failure you encountered
                        sh 'mvn test -Dmaven.compiler.source=1.8 -Dmaven.compiler.target=1.8 -Dfindbugs.skip=true'
                    }
                }
                stage('Code Quality Analysis') {
                    when { expression { return params.SKIP_QUALITY == false } }
                    steps {
                        echo "Starting Code Quality Analysis (Checkstyle)..."
                        sh 'mvn checkstyle:checkstyle -Dmaven.compiler.source=1.8 -Dmaven.compiler.target=1.8 -Dfindbugs.skip=true'
                    }
                }
                stage('Code Coverage Analysis') {
                    when { expression { return params.SKIP_COVERAGE == false } }
                    steps {
                        echo "Starting Code Coverage Analysis (Jacoco)..."
                        sh 'mvn org.jacoco:jacoco-maven-plugin:0.8.8:prepare-agent test org.jacoco:jacoco-maven-plugin:0.8.8:report -Dmaven.compiler.source=1.8 -Dmaven.compiler.target=1.8 -Ddependency-check.skip=true -DforkCount=0 -Dfindbugs.skip=true'
                    }
                }
            }
        }

        stage('Archive Reports') {
            steps {
                echo "Saving analysis reports to the Jenkins dashboard..."
                archiveArtifacts artifacts: '**/target/site/**', allowEmptyArchive: true
            }
        }

        stage('Manual Approval') {
            steps {
                echo "Waiting for manual approval..."
                input message: "Are all reports correct? Do you want to proceed?", ok: "Proceed"
            }
        }

        stage('Build & Publish Artifact') {
            steps {
                echo "Generating the final WAR file..."
                sh 'mvn package -DskipTests -Dmaven.compiler.source=1.8 -Dmaven.compiler.target=1.8 -Dfindbugs.skip=true'
                archiveArtifacts artifacts: '**/target/*.war'
            }
        }
    }

    post {
        always {
            // This will run regardless of build status
            echo 'Finalizing build report...'
        }
        success {
            // Send Slack notification on Success
            slackSend(channel: '#new-channel', 
                      color: 'good', 
                      message: "SUCCESS: Job ${env.JOB_NAME} [${env.BUILD_NUMBER}] (${env.BUILD_URL})")
            
            // Send Email notification on Success
            mail to: 'bhavna123porwal@gmail.com',
                 from: 'bhavna123porwal@gmail.com',
                 subject: "Success: ${env.JOB_NAME} Build #${env.BUILD_NUMBER}",
                 body: "Check details at ${env.BUILD_URL}"
        }
        failure {
            // Send Slack notification on Failure
            slackSend(channel: '#new-channel', 
                      color: 'danger', 
                      message: "FAILED: Job ${env.JOB_NAME} [${env.BUILD_NUMBER}] (${env.BUILD_URL})")
            
            // Send Email notification on Failure
            mail to: 'bhavna123porwal@gmail.com',
                 from: 'bhavna123porwal@gmail.com',
                 subject: "FAILURE: ${env.JOB_NAME} Build #${env.BUILD_NUMBER}",
                 body: "The build failed. Please check the logs at ${env.BUILD_URL}"
        }
    }
}
